<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="IceColdApp.ReservaPage"
             Title="Seleccionar fecha y hora"
             BackgroundColor="#0A0F1D">

    <Grid RowDefinitions="*, Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20" Spacing="20">

                <Label Text="Tipo de Servicio" TextColor="White" FontSize="16" FontAttributes="Bold" />
                <Border BackgroundColor="#1E293B" StrokeThickness="0" Padding="10,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Picker x:Name="PickerServicio" 
                            Title="Elige tu servicio..." 
                            TextColor="White" 
                            TitleColor="#A0AEC0"
                            SelectedIndexChanged="OnServicioChanged" />
                </Border>

                <Label Text="Barbero" TextColor="White" FontSize="16" FontAttributes="Bold" Margin="0,10,0,0"/>
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout x:Name="ListaBarberos" Spacing="15">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout Spacing="5" HorizontalOptions="Center" WidthRequest="70">
                                    <Border HeightRequest="60" WidthRequest="60" StrokeShape="RoundRectangle 30" 
                                            BackgroundColor="{Binding FondoColor}" Stroke="{Binding BordeColor}" StrokeThickness="2">

                                        <Image Source="{Binding Imagen}" Aspect="AspectFill" Margin="2">
                                            <Image.Clip>
                                                <EllipseGeometry RadiusX="28" RadiusY="28" Center="28,28" />
                                            </Image.Clip>
                                        </Image>

                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnBarberoTapped" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                    <Label Text="{Binding Nombre}" TextColor="White" FontSize="12" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>

                <BoxView HeightRequest="1" Color="#1E293B" Margin="0,10" />

                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10" VerticalOptions="Center">
                    <Label x:Name="MesAnioLabel" Grid.Column="0" Text="Mes y Año" TextColor="White" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />

                    <Border Grid.Column="1" HeightRequest="40" WidthRequest="40" StrokeShape="RoundRectangle 8" BackgroundColor="#1E293B" StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMesAnteriorTapped" />
                        </Border.GestureRecognizers>
                        <Label Text="&lt;" TextColor="White" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <Border Grid.Column="2" HeightRequest="40" WidthRequest="40" StrokeShape="RoundRectangle 8" BackgroundColor="#1E293B" StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMesSiguienteTapped" />
                        </Border.GestureRecognizers>
                        <Label Text="&gt;" TextColor="White" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="*,*,*,*,*,*,*" Margin="0,10,0,0">
                    <Label Grid.Column="0" Text="Lun" TextColor="#A0AEC0" FontSize="12" HorizontalTextAlignment="Center" />
                    <Label Grid.Column="1" Text="Mar" TextColor="#A0AEC0" FontSize="12" HorizontalTextAlignment="Center" />
                    <Label Grid.Column="2" Text="Mié" TextColor="#A0AEC0" FontSize="12" HorizontalTextAlignment="Center" />
                    <Label Grid.Column="3" Text="Jue" TextColor="#A0AEC0" FontSize="12" HorizontalTextAlignment="Center" />
                    <Label Grid.Column="4" Text="Vie" TextColor="#A0AEC0" FontSize="12" HorizontalTextAlignment="Center" />
                    <Label Grid.Column="5" Text="Sáb" TextColor="#A0AEC0" FontSize="12" HorizontalTextAlignment="Center" />
                    <Label Grid.Column="6" Text="Dom" TextColor="#A0AEC0" FontSize="12" HorizontalTextAlignment="Center" />
                </Grid>

                <FlexLayout x:Name="ContenedorDias" Wrap="Wrap" Direction="Row" JustifyContent="Start">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <ContentView FlexLayout.Basis="14.28%">
                                <VerticalStackLayout HeightRequest="60" Spacing="2" HorizontalOptions="Center" Margin="0,5">
                                    <Border HeightRequest="40" WidthRequest="40" StrokeShape="RoundRectangle 20" 
                                            BackgroundColor="{Binding FondoColor}" Stroke="{Binding BordeColor}" StrokeThickness="2" HorizontalOptions="Center">
                                        <Label Text="{Binding Numero}" TextColor="{Binding TextoColor}" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />

                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnDiaTapped" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                    <BoxView HeightRequest="4" WidthRequest="12" CornerRadius="2" Color="{Binding PuntoColor}" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </ContentView>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <BoxView HeightRequest="1" Color="#1E293B" Margin="0,10" />

                <Label Text="Horas disponibles" TextColor="White" FontSize="16" FontAttributes="Bold" />

                <Label Text="No hay horas disponibles para este día/barbero." 
                       TextColor="#EF4444" 
                       FontSize="13" 
                       IsVisible="{Binding Count, Source={x:Reference ListaHoras}, Converter={x:StaticResource InvertedBoolConverter}, FallbackValue=False}" />

                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout x:Name="ListaHoras" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{Binding FondoColor}" Stroke="{Binding BordeColor}" StrokeThickness="2" Padding="15,10" Margin="0,0,5,0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding Hora}" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnHoraTapped" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>

                <BoxView HeightRequest="30" Color="Transparent" />
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" BackgroundColor="#1E293B" StrokeThickness="0" Padding="20">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20,20,0,0" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*, Auto">
                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                        <Label x:Name="ResumenServicio" Text="Selecciona servicio" TextColor="#A0AEC0" FontSize="13" />
                        <Label x:Name="ResumenPrecio" Text="0,00 €" TextColor="White" FontSize="22" FontAttributes="Bold" />
                    </VerticalStackLayout>

                    <Button Grid.Column="1" Text="Continuar" BackgroundColor="#29B6F6" TextColor="White" 
                            FontAttributes="Bold" CornerRadius="8" WidthRequest="140" HeightRequest="45" Clicked="OnContinuarClicked" />
                </Grid>

                <Label Text="Tus datos personales serán procesados para gestionar tu cita." 
                       TextColor="#A0AEC0" FontSize="11" HorizontalTextAlignment="Center" Margin="0,10,0,0" />
            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>